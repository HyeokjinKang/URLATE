<!DOCTYPE html>
<html lang="<%= __('lang') %>">
  <head>
    <meta charset="UTF-8" />
    <title>URLATE Client</title>
    <link rel="preconnect" href="<%= cdn %>" crossorigin />
    <link rel="stylesheet" href="/css/fonts.css?v=<%= ver %>" />
    <link rel="stylesheet" href="/css/montserrat.css" />
    <link rel="stylesheet" href="/css/pretendard.css" />
    <link rel="stylesheet" href="/css/metropolis.css?v=<%= ver %>" />
    <link rel="stylesheet" href="/css/iziToast.min.css" />
    <link rel="stylesheet" href="/css/globalSocket.css?v=<%= ver %>" />
    <link rel="stylesheet" href="/css/game.css?v=<%= ver %>" />
    <link rel="stylesheet" href="/css/cursors.css?v=<%= ver %>" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <script data-pace-options='{ "eventLag": false }' src="/lib/pace.min.js"></script>
  </head>
  <body>
    <div id="footer">
      <div id="footerLeft">
        <img src="/images/icons/cursor-pointer.svg" class="icon" />
        <span class="medium">&nbsp;&nbsp;Click to <strong>Select</strong></span>
      </div>
      <div id="footerCenter">
        <strong id="songName"
          ><img src="/images/icons/note.webp" id="noteIcon" /><span id="songNameText">&nbsp;URLATE Theme</span></strong
        >
        <span id="urlateText"><strong>URLATE</strong> LITE</span>
      </div>
      <div id="footerRight">
        <span
          ><span class="medium"
            ><%= __('more_info_before') %><a
              href="https://urlate.coupy.dev/info"
              target="_blank"
              rel="noopener noreferrer"
              class="link"
              ><%= __('more_info_link') %></a
            ><%= __('more_info_after') %></span
          ><br />&copy; 2025 <strong>URLATE</strong>, All contents cannot be copied without permission.</span
        >
      </div>
    </div>
    <div id="warningContainer" class="introContainer">
      <span id="warningTitle"><%= __('warning') %></span>
      <div id="warningInner">
        <span><%= __('warning_body') %></span>
      </div>
      <span id="pressAnywhere"><%= __('loading') %></span>
    </div>
    <div id="intro1container" class="introContainer" data-action="intro1skip">
      <video id="intro1video">
        <source type="video/webm" src="<%= cdn %>/videos/croissant.webm" />
        <source type="video/mp4" src="<%= cdn %>/videos/croissant.mp4" />
      </video>
    </div>
    <div id="intro2container" class="introContainer" data-action="intro2skip">
      <video id="intro2video">
        <source type="video/webm" src="<%= cdn %>/videos/coupyworks.webm" />
        <source type="video/mp4" src="<%= cdn %>/videos/coupyworks.mp4" />
      </video>
    </div>
    <div id="loadingContainer">
      <img src="/images/brand/logo-lite.webp" id="logo" />
    </div>
    <div id="header">
      <div id="headerLeft">
        <img src="" id="profilePic" data-action="profileScreen" />
        <span id="name" class="metropolis" data-action="profileScreen">USERNAME</span>
      </div>
      <div id="headerRight">
        <%# Filled by game.js. The wrapper is display: contents, so hiding it takes the divider with the link and leaves
        no gap in the header row. %>
        <span id="noticeSlot" class="hide">
          <a id="noticeText" target="_blank" rel="noopener noreferrer"></a>
          <div id="line"></div>
        </span>
        <img src="/images/icons/info-circle.svg" class="icon clickable" data-action="infoScreen" />
        <div id="line"></div>
        <img src="/images/icons/settings.svg" class="icon clickable" data-action="optionScreen" />
      </div>
    </div>
    <div id="tutorialInformation" class="containers metropolis">
      <div id="tutorialInfoTop" class="tutorialInner">
        <h1 class="containersTitle"><span class="light">Welcome to</span> URLATE!</h1>
        <span id="tutorialText"><%= __('tutorial_prompt') %></span>
      </div>
      <div id="tutorialInfoMid" class="tutorialInner">
        <img src="/images/ui/elements.webp" alt="O O O" loading="lazy" />
      </div>
      <div id="tutorialInfoBottom" class="tutorialInner">
        <button class="storeButton metropolis" data-action="goTutorial"><%= __('tutorial_accept') %></button>
        <span id="tutorialSkip" data-action="tutorialSkip"><%= __('tutorial_skip') %></span>
      </div>
    </div>
    <div id="menuContainer">
      <div class="menuSelector clickable" data-action="menuSelected" data-arg="0">
        <div class="fadeIconContainer">
          <img src="/images/nav/play.webp" class="mainIcon" loading="lazy" />
          <img src="/images/nav/play-active.webp" class="fadeIcon" loading="lazy" />
        </div>
        <span class="menuTitle"><%= __('play_title') %></span>
        <span class="light menuSubtitle"><%= __('play_subtitle') %></span>
      </div>
      <div class="menuSelector clickable" data-action="menuSelected" data-arg="1">
        <div class="fadeIconContainer">
          <img src="/images/nav/editor.webp" class="mainIcon" loading="lazy" />
          <img src="/images/nav/editor-active.webp" class="fadeIcon" loading="lazy" />
        </div>
        <span class="menuTitle"><%= __('editor_title') %></span>
        <span class="light menuSubtitle"><%= __('editor_subtitle') %></span>
      </div>
      <div class="menuSelector clickable" data-action="menuSelected" data-arg="2">
        <div class="fadeIconContainer">
          <img src="/images/nav/rank.webp" class="mainIcon" loading="lazy" />
          <img src="/images/nav/rank-active.webp" class="fadeIcon" loading="lazy" />
        </div>
        <span class="menuTitle"><%= __('rank_title') %></span>
        <span class="light menuSubtitle"><%= __('rank_subtitle') %></span>
      </div>
      <div class="menuSelector clickable" data-action="menuSelected" data-arg="3">
        <div class="fadeIconContainer">
          <img src="/images/nav/info.webp" class="mainIcon" loading="lazy" />
          <img src="/images/nav/info-active.webp" class="fadeIcon" loading="lazy" />
        </div>
        <span class="menuTitle"><%= __('about_title') %></span>
        <span class="light menuSubtitle"><%= __('about_subtitle') %></span>
      </div>
    </div>
    <div id="selectContainer" class="containers metropolis">
      <div id="selectBackground"></div>
      <div id="selectInnerContainer">
        <div id="visualizer"><canvas id="renderer"></canvas></div>
        <img
          src="/images/icons/xmark-circle-ffffff.svg"
          class="icon clickable closeBtn"
          data-action="displayClose"
          loading="lazy"
        />
        <span class="escKey escKeyLight">ESC</span>
        <div id="selectContainerTopLeft">
          <img src="/images/ui/tracks.webp" id="tracks" loading="lazy" />
          <div id="tracksLine"></div>
          <span class="tracksSelection selected"> <strong>Official</strong> Pattern</span>
          <span class="tracksSelection"> <strong>Community</strong> Pattern <span class="bottomArrow">▼</span> </span>
        </div>
        <div id="selectContainerLeft">
          <div id="selectContainerTitle">
            <div id="selectContainerTitleLeft">
              <span id="selectTitle"></span>
              <span id="selectArtist"></span>
            </div>
            <div id="selectContainerTitleRight">
              <span id="selectScore">SCORE</span>
              <span id="selectScoreValue"></span>
            </div>
          </div>
          <div id="selectContainerAlbum">
            <div id="selectContainerAlbumLeft">
              <div id="selectAlbumContainer">
                <img id="selectAlbum" />
                <div id="starContainer">
                  <span id="selectStars">★★★★★☆☆☆☆☆</span>
                </div>
              </div>
            </div>
            <div id="selectContainerAlbumRight">
              <span id="trackStats">TRACK STATISTICS</span>
              <div class="trackStatContainer">
                <span><%= __('bullet_density') %></span>
                <span id="bulletDensity">0</span>
              </div>
              <div class="trackStatLineContainer"><div class="trackStatLine" id="bulletDensityValue"></div></div>
              <div class="trackStatContainer">
                <span><%= __('note_density') %></span>
                <span id="noteDensity">0</span>
              </div>
              <div class="trackStatLineContainer"><div class="trackStatLine" id="noteDensityValue"></div></div>
              <div class="trackStatContainer">
                <span>BPM</span>
                <span id="bpmText">0</span>
              </div>
              <div class="trackStatLineContainer"><div class="trackStatLine" id="bpmValue"></div></div>
              <div class="trackStatContainer">
                <span><%= __('speed') %></span>
                <span id="speed">0</span>
              </div>
              <div class="trackStatLineContainer"><div class="trackStatLine" id="speedValue"></div></div>
              <div id="modsTitleContainer">
                <div class="modsTitleLine"></div>
                <div id="modsTitle">MODS</div>
                <div class="modsTitleLine"></div>
              </div>
              <div class="trackStatContainer">
                <span class="trackModsTitle"><%= __('playback_rate') %></span>
                <input
                  type="number"
                  id="trackModsRate"
                  class="trackModsValue metropolis"
                  value="1.0"
                  data-change="rateChanged"
                />
              </div>
              <div class="trackStatContainer">
                <span class="trackModsTitle"><%= __('disable_text') %></span>
                <div class="trackModsValue" id="trackModsText" data-action="textDisabled">No</div>
              </div>
            </div>
          </div>
          <div id="selectContainerInfo">
            <div class="selectInfo">
              <div class="selectInfoTitleContainer">
                <span class="selectInfoTitle">DIFFICULTY</span>
                <span class="key">TAB</span>
              </div>
              <div class="selectInfoContentsContainer">
                <div class="difficulty difficultySelected" data-action="difficultySelected" data-arg="0">
                  <span class="difficultyNumber">1</span><span class="difficultyText">EZ</span>
                </div>
                <div class="difficulty" data-action="difficultySelected" data-arg="1">
                  <span class="difficultyNumber">3</span><span class="difficultyText">MID</span>
                </div>
                <div class="difficulty right" data-action="difficultySelected" data-arg="2">
                  <span class="difficultyNumber">5</span><span class="difficultyText">HARD</span>
                </div>
              </div>
            </div>
            <div class="selectInfo clickable" data-action="rankToggle">
              <div class="selectInfoTitleContainer">
                <span class="selectInfoTitle">RANK</span>
                <span class="key">F2</span>
              </div>
              <div class="selectInfoContentsContainer">
                <span id="selectRank">-</span>
              </div>
            </div>
            <div class="selectInfo clickable" data-action="medalDescription">
              <div class="selectInfoTitleContainer">
                <span class="selectInfoTitle">MEDAL</span>
                <span class="key">?</span>
              </div>
              <div class="selectInfoContentsContainer">
                <img src="/images/icons/ap.svg" class="medals" id="goldMedal" loading="lazy" />
                <img src="/images/icons/fc.svg" class="medals" id="silverMedal" loading="lazy" />
                <img src="/images/icons/clear.svg" class="medals" id="checkMedal" loading="lazy" />
              </div>
            </div>
          </div>
        </div>
        <div id="selectContainerRight">
          <div id="selectContainerRightTitles">
            <span class="sortText selected" data-action="sortSelected" data-arg="0"><%= __('sort_as_name') %></span>
            <span class="sortText" data-action="sortSelected" data-arg="1"><%= __('sort_as_producer') %></span>
            <span class="sortText" data-action="sortSelected" data-arg="2"><%= __('sort_as_difficulty') %></span>
            <span class="sortText" id="sortTextRight" data-action="sortSelected" data-arg="3"
              ><%= __('sort_as_bpm') %></span
            >
            <div id="trackListLine"></div>
            <span id="trackList">TRACK <strong>LIST</strong></span>
          </div>
          <div id="selectSongContainer"></div>
        </div>
        <div id="selectRankContainer">
          <div id="selectRankInnerContainer">
            <div id="selectRankTitleContainer">
              <div id="selectRankTitleLeftContainer">
                <span id="selectRankTitle"><strong>R</strong>ANKING</span>
              </div>
              <div id="selectRankTitleRightContainer">
                <img
                  src="/images/icons/xmark-circle-ffffff.svg"
                  class="icon clickable rankCloseBtn"
                  data-action="displayClose"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="selectRank">
              <div class="selectRankNumber rankGuide">#</div>
              <div class="selectRankName rankGuide">NAME</div>
              <div class="selectRankScore rankGuide">SCORE</div>
            </div>
            <div id="selectRankScoreContainer"></div>
          </div>
        </div>
      </div>
    </div>
    <div id="advancedContainer" class="containers">
      <img
        src="/images/icons/xmark-circle-000000.svg"
        class="icon clickable closeBtn"
        data-action="displayClose"
        loading="lazy"
      />
      <span class="escKey">ESC</span>
      <h1 id="rankTitle" class="overlayTitle"><%= __('rank_title') %></h1>
      <table id="rankTable">
        <thead>
          <tr>
            <th>#</th>
            <th><%= __('profile') %></th>
            <th><%= __('average_accuracy') %></th>
            <th><%= __('score_sum') %></th>
            <th><%= __('rating') %></th>
          </tr>
        </thead>
        <tbody id="rankTableBody"></tbody>
      </table>
    </div>
    <div id="infoContainer" class="containers metropolis">
      <div id="infoProfileContainer" class="containers">
        <img
          src="/images/icons/xmark-circle-000000.svg"
          class="icon clickable closeBtn"
          data-action="displayClose"
          loading="lazy"
        />
        <span class="escKey">ESC</span>
        <div id="infoProfileLeft">
          <img src="" id="infoProfileImg" loading="lazy" />
        </div>
        <div id="infoProfileRight">
          <div id="infoProfileTop">
            <span id="infoProfileName"></span>
            <span id="infoProfilePosition"></span>
          </div>
          <div id="infoProfileBottom"></div>
        </div>
      </div>
      <img
        src="/images/icons/xmark-circle-000000.svg"
        class="icon clickable closeBtn"
        data-action="displayClose"
        loading="lazy"
      />
      <span class="escKey">ESC</span>
      <img src="/images/brand/logo-lite.webp" id="infoLogo" loading="lazy" />
      <br />
      <span id="license">
        <span id="licenseMain">URLATE is under the AGPLv3 License.</span>
        <br /><br />
        Copyright notices for resources included in the game are located at
        <a href="https://urlate.coupy.dev/info" target="_blank" class="link">urlate.coupy.dev/info</a>.
        <br />
        Excluding some music and images, URLATE resources are copyrighted by Coupy.
      </span>
      <div class="infoLineContainer"><div class="infoLine"></div></div>
      <span class="infoTitle">Producer</span>
      <br />
      <span class="infoSubtitle">Game directed, developed, operated by</span>
      <br />
      <div class="profileContainer">
        <div class="profile" id="profileCoupy">
          <div class="profileHover" data-action="showProfile" data-arg="coupy">Coupy</div>
        </div>
      </div>
      <span class="infoTitle">Designer</span>
      <br />
      <span class="infoSubtitle">Game designed by</span>
      <br />
      <div class="profileContainer">
        <div class="profile" id="profileAlta">
          <div class="profileHover" data-action="showProfile" data-arg="altari">Altari</div>
        </div>
      </div>
      <span class="infoTitle">Contributors</span>
      <br />
      <span class="infoSubtitle">(ex- Team Croissant)</span>
      <br />
      <div class="profileContainer">
        <div class="profile" id="profileShd">
          <div class="profileHover" data-action="showProfile" data-arg="sihyeon">Sihyeon</div>
        </div>
        <div class="profile" id="profileGreenstar">
          <div class="profileHover" data-action="showProfile" data-arg="greenstar">Greenstar</div>
        </div>
        <div class="profile" id="profileRanol">
          <div class="profileHover" data-action="showProfile" data-arg="ranolp">RanolP</div>
        </div>
        <div class="profile" id="profileKiwi">
          <div class="profileHover" data-action="showProfile" data-arg="kiwiyou">kiwiyou</div>
        </div>
      </div>
      <span class="infoTitle">Thanks to</span>
      <br />
      <div class="profileContainer">
        <div class="profile" id="profileHanu">
          <div class="profileHover" data-action="showProfile" data-arg="hanu">Hanu</div>
        </div>
        <div class="profile" id="profileGeoplex">
          <div class="profileHover" data-action="showProfile" data-arg="geoplex">Geoplex</div>
        </div>
        <div class="profile" id="profileAlkmerlin">
          <div class="profileHover" data-action="showProfile" data-arg="alkmerlin">ALK</div>
        </div>
        <div class="profile" id="profileYou">..and You</div>
      </div>
      <div class="infoLineContainer"><div class="infoLine"></div></div>
      <span class="infoTitle">Tumblbug Supporters</span>
      <br />
      <img src="/images/credits/supporters.svg" id="tumblbug" loading="lazy" />
    </div>
    <div id="optionContainer" class="containers">
      <div id="offsetContiner" class="containers">
        <img
          src="/images/icons/xmark-circle-000000.svg"
          class="icon clickable closeBtn"
          data-action="displayClose"
          loading="lazy"
        />
        <span class="escKey">ESC</span>
        <h1 id="offsetTitle" class="overlayTitle"><%= __('offset_setting') %></h1>
        <div class="syncLayout">
          <div class="optionCard syncPreview">
            <div class="optionCardHead syncHead">
              <p class="optionTitle" id="offsetDescription">
                <%= __('offset_description_before') %><strong><%= __('offset_description_strong') %></strong
                ><%= __('offset_description_after') %>
              </p>
              <p class="optionNote" id="offsetSubDescription"><%= __('offset_sub_description') %></p>
            </div>
            <canvas
              id="offsetCanvas"
              class="syncCanvas"
              data-input="<%= __('input') %>"
              data-offset="<%= __('offset') %>"
            ></canvas>
          </div>
          <div class="optionCard syncControls">
            <div id="offsetTapButton" class="syncValue">
              <span id="offsetButtonText" class="metropolis">TAP</span>
            </div>
            <div class="optionRow">
              <p class="optionSemiTitle"><%= __('offset') %></p>
              <div class="optionControl syncStepper">
                <img
                  src="/images/icons/minus.svg"
                  class="syncStepperButton clickable"
                  data-action="offsetDown"
                  loading="lazy"
                />
                <img
                  src="/images/icons/plus.svg"
                  class="syncStepperButton clickable"
                  data-action="offsetUp"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="optionRow">
              <p class="optionSemiTitle"><%= __('speed') %></p>
              <div class="optionControl syncStepper">
                <img
                  src="/images/icons/minus.svg"
                  class="syncStepperButton clickable"
                  data-action="offsetSpeedDown"
                  loading="lazy"
                />
                <span id="offsetSpeedText" class="syncStepperValue">1x</span>
                <img
                  src="/images/icons/plus.svg"
                  class="syncStepperButton clickable"
                  data-action="offsetSpeedUp"
                  loading="lazy"
                />
              </div>
            </div>
            <a class="optionButton optionButtonDanger syncReset" id="offsetResetButton" data-action="offsetReset"
              ><span id="offsetResetButtonText"><%= __('reset') %></span></a
            >
          </div>
        </div>
      </div>
      <div id="visualSyncContainer" class="containers">
        <img
          src="/images/icons/xmark-circle-000000.svg"
          class="icon clickable closeBtn"
          data-action="displayClose"
          loading="lazy"
        />
        <span class="escKey">ESC</span>
        <h1 id="visualSyncTitle" class="overlayTitle"><%= __('visual_sync_setting') %></h1>
        <div class="syncLayout">
          <div class="optionCard syncPreview">
            <div class="optionCardHead syncHead">
              <p class="optionTitle" id="visualSyncDescription">
                <strong><%= __('visual_sync_description_strong') %></strong><%= __('visual_sync_description_after') %>
              </p>
              <p class="optionNote" id="visualSyncSubDescription"><%= __('visual_sync_sub_description') %></p>
            </div>
            <canvas id="visualSyncCanvas" class="syncCanvas"></canvas>
          </div>
          <div class="optionCard syncControls">
            <div id="visualSyncValueDisplay" class="syncValue">
              <span id="visualSyncValueText" class="metropolis">0ms</span>
            </div>
            <div class="optionRow">
              <p class="optionSemiTitle"><%= __('sync') %></p>
              <div class="optionControl syncStepper">
                <img
                  src="/images/icons/minus.svg"
                  class="syncStepperButton clickable"
                  data-action="visualSyncDown"
                  loading="lazy"
                />
                <img
                  src="/images/icons/plus.svg"
                  class="syncStepperButton clickable"
                  data-action="visualSyncUp"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="optionRow">
              <p class="optionSemiTitle"><%= __('speed') %></p>
              <div class="optionControl syncStepper">
                <img
                  src="/images/icons/minus.svg"
                  class="syncStepperButton clickable"
                  data-action="offsetSpeedDown"
                  loading="lazy"
                />
                <span id="visualSyncSpeedText" class="syncStepperValue">1x</span>
                <img
                  src="/images/icons/plus.svg"
                  class="syncStepperButton clickable"
                  data-action="offsetSpeedUp"
                  loading="lazy"
                />
              </div>
            </div>
            <a
              class="optionButton optionButtonDanger syncReset"
              id="visualSyncResetButton"
              data-action="visualSyncReset"
              ><span id="visualSyncResetButtonText"><%= __('reset') %></span></a
            >
          </div>
        </div>
      </div>
      <img
        src="/images/icons/xmark-circle-000000.svg"
        class="icon clickable closeBtn"
        data-action="displayClose"
        loading="lazy"
      />
      <span class="escKey">ESC</span>
      <h1 id="optionHeading" class="overlayTitle"><%= __('settings') %></h1>
      <div id="optionElementsContainer">
        <div id="optionSelectorContainer">
          <span class="optionSelectors optionSelected" data-action="optionSelect" data-arg="0"
            ><span class="optionSelectorIndex">01</span><%= __('general') %></span
          >
          <span class="optionSelectors" data-action="optionSelect" data-arg="1"
            ><span class="optionSelectorIndex">02</span><%= __('screen') %></span
          >
          <span class="optionSelectors" data-action="optionSelect" data-arg="2"
            ><span class="optionSelectorIndex">03</span><%= __('sound') %></span
          >
          <span class="optionSelectors" data-action="optionSelect" data-arg="3"
            ><span class="optionSelectorIndex">04</span><%= __('input') %></span
          >
          <span class="optionSelectors" data-action="optionSelect" data-arg="4"
            ><span class="optionSelectorIndex">05</span><%= __('ingame') %></span
          >
          <span class="optionSelectors" data-action="optionSelect" data-arg="5"
            ><span class="optionSelectorIndex">06</span><%= __('editor_title') %></span
          >
        </div>
        <div class="optionContentsContainer optionShow" id="optionGeneral">
          <h2 class="optionPanelTitle"><%= __('general') %></h2>
          <div class="optionCard">
            <div class="optionCardHead">
              <p class="optionTitle"><%= __('my_info') %></p>
            </div>
            <div class="optionRow">
              <p class="optionSemiTitle"><%= __('name_placeholder') %></p>
              <div class="optionControl">
                <p class="optionValue" id="optionName">USERNAME</p>
                <a class="optionButton optionButtonDanger" data-action="logout" id="logoutButton"
                  ><%= __('logout') %></a
                >
              </div>
            </div>
          </div>
          <div class="optionCard">
            <div class="optionCardHead">
              <p class="optionTitle"><%= __('language') %></p>
              <p class="optionNote"><%= __('language_warning') %></p>
            </div>
            <div class="optionRow">
              <p class="optionSemiTitle"><%= __('language_general') %></p>
              <div class="optionControl">
                <select class="optionSelect" id="langSelector" data-change="langChanged">
                  <option value="ko">한국어</option>
                  <option value="en">English</option>
                </select>
              </div>
            </div>
            <div class="optionRow">
              <p class="optionSemiTitle"><%= __('music_artist') %></p>
