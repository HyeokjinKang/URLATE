<!DOCTYPE html>
<html lang="<%= __('lang') %>" itemscope itemtype="http://schema.org/Article">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:title" content="URLATE" />
    <meta property="og:site_name" content="URLATE" />
    <meta property="og:url" content="<%= url %>" />
    <meta property="description" content="Avoid & Get on the tempo, URLATE" />
    <meta property="og:description" content="Avoid & Get on the tempo, URLATE" />
    <meta property="og:image" content="<%= url %>/images/og-thumbnail.png" />
    <%# Keep these in step with og-thumbnail.png if it is ever replaced. %>
    <meta property="og:image:width" content="1240" />
    <meta property="og:image:height" content="592" />
    <meta name="naver-site-verification" content="7ae378668c928c7b17400b60b364b844a751c1f1" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="preconnect" href="<%= cdn %>" crossorigin />
    <%# The mark on the plate is the fold's largest paint; it should not wait on the stylesheet. %>
    <link rel="preload" as="image" href="/images/brand/logo-white.webp" fetchpriority="high" />
    <%- inlineCss("montserrat", "pretendard", "tokens", "index") %>
    <title>URLATE</title>
  </head>
  <body>
    <div
      id="g_id_onload"
      data-client_id="<%= googleClientId %>"
      data-context="signin"
      data-ux_mode="popup"
      data-callback="handleCredentialResponse"
      data-auto_prompt="true"
      data-use_fedcm_for_prompt="true"
    ></div>
    <%# The theme's ground: the 12 column rules, drawn in public behind everything. %>
    <div class="rails" aria-hidden="true"></div>

    <header class="shell mast">
      <p class="mast__issue label">
        <% if(branch != "main") { %>
        <span><%= branch %></span>
        <% } else { %>
        <span><%= ver %></span>
        <% } %>
      </p>
      <div class="mast__row">
        <a class="mast__name" href="/">Project URLATE-v3l<i class="period" aria-hidden="true"></i></a>
        <nav class="mast__nav label" aria-label="<%= __('idx_nav_label') %>">
          <a href="/info"><%= __('idx_nav_info') %></a>
          <a href="https://github.com/HyeokjinKang/URLATE" target="_blank" rel="noopener noreferrer">GitHub</a>
          <% if(__('lang') == 'en') { %>
          <a href="/ko" lang="ko">한국어</a>
          <% } else { %>
          <a href="/en" lang="en">English</a>
          <% } %>
        </nav>
      </div>
    </header>

    <main>
      <%# The one flooded band on the page. The mark is white-lettered, so ink is
          the only ground it reads on -- and the sign-in belongs beside it. %>
      <section class="plate" aria-labelledby="claim">
        <div class="shell plate__inner">
          <div class="plate__brand">
            <%# The white mark, restored in this branch. The colour variant is a violet
                gradient that reads as a smear on the ink plate, and its black "LITE"
                wordmark disappears there outright. %>
            <%# index_logoAlt is the tagline, which the h1 below already reads out. %>
            <img src="/images/brand/logo-white.webp" id="logo" class="plate__logo" alt="URLATE" width="1000" height="590" />
            <%# The tagline is the brand's own line and is not translated. %>
            <h1 class="plate__claim" id="claim" lang="en">Avoid &amp; Get on the tempo<i class="period period--on-ink" aria-hidden="true"></i></h1>
            <p class="plate__lede"><%= __('idx_lede') %></p>
          </div>
          <div class="plate__enter">
            <p class="label plate__enter-label"><%= __('idx_signin') %></p>
            <%# data-width is set from the measured column in index.js -- a fixed 400
                (GSI's widest) overflows the column on a narrow desktop window. %>
            <div class="g_id_signin" data-type="standard" data-shape="pill" data-theme="outline" data-text="signin_with" data-locale="<%= __('lang') %>" data-size="large" data-logo_alignment="left"></div>
            <p id="loginNotice" class="hide"><%= __('login_blocked') %></p>
            <p id="unsupportedNotice" class="hide"><%= __('idx_unsupported') %></p>
          </div>
        </div>
      </section>

      <section class="shell feeds" aria-label="<%= __('idx_feeds_label') %>">
        <div class="feed">
          <div class="feed__head">
            <h2 class="label"><%= __('idx_feed_notice') %></h2>
            <a class="feed__all label" href="<%= announcementsUrl %>" target="_blank" rel="noopener noreferrer"><%= __('idx_feed_all') %> <span aria-hidden="true">&rarr;</span></a>
          </div>
          <% if(announcements.length) { %>
          <ol class="feed__list">
            <% announcements.forEach(function(item) { %>
            <li class="feed__row">
              <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer">
                <time class="feed__date" datetime="<%= item.iso %>"><%= item.date %></time>
                <span class="feed__title"><%= item.title %></span>
              </a>
            </li>
            <% }); %>
          </ol>
          <% } else { %>
          <p class="feed__empty"><%= __('idx_feed_empty') %></p>
          <% } %>
        </div>
        <div class="feed feed--second">
          <div class="feed__head">
            <h2 class="label"><%= __('idx_feed_journal') %></h2>
            <a class="feed__all label" href="<%= journalUrl %>" target="_blank" rel="noopener noreferrer"><%= __('idx_feed_all') %> <span aria-hidden="true">&rarr;</span></a>
          </div>
          <% if(journal.length) { %>
          <ol class="feed__list">
            <% journal.forEach(function(item) { %>
            <li class="feed__row">
              <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer">
                <time class="feed__date" datetime="<%= item.iso %>"><%= item.date %></time>
                <span class="feed__title"><%= item.title %></span>
              </a>
            </li>
            <% }); %>
          </ol>
          <% } else { %>
          <p class="feed__empty"><%= __('idx_feed_empty') %></p>
          <% } %>
        </div>
      </section>

      <hr class="shell rule rule--ink" />

      <%# 1.0 -> 4.0. The occupied side steps across the page so no two stages
          share a silhouette; 4.0 goes full width and the spec sheet carries no
          figure at all. %>
      <section class="shell stage stage--right">
        <p class="stage__numeral" aria-hidden="true">1</p>
        <div class="stage__text">
          <p class="stage__no label">1.0</p>
          <h2 class="stage__title"><%= __('idx_stage1_title') %></h2>
          <p class="stage__body"><%= __('idx_stage1_body') %></p>
        </div>
        <figure class="stage__figure">
          <img src="/images/landing/select.webp" width="1400" height="735" loading="lazy" decoding="async" alt="<%= __('idx_stage1_alt') %>" />
          <figcaption class="label"><%= __('idx_stage1_caption') %></figcaption>
        </figure>
      </section>

      <section class="shell stage stage--left">
        <p class="stage__numeral" aria-hidden="true">2</p>
        <div class="stage__text">
          <p class="stage__no label">2.0</p>
          <h2 class="stage__title"><%= __('idx_stage2_title') %></h2>
          <p class="stage__body"><%= __('idx_stage2_body') %></p>
        </div>
        <figure class="stage__figure">
          <img src="/images/landing/gameplay.webp" width="1400" height="788" loading="lazy" decoding="async" alt="<%= __('idx_stage2_alt') %>" />
          <figcaption class="label"><%= __('idx_stage2_caption') %></figcaption>
        </figure>
      </section>

      <section class="shell stage stage--right">
        <p class="stage__numeral" aria-hidden="true">3</p>
        <div class="stage__text">
          <p class="stage__no label">3.0</p>
          <h2 class="stage__title"><%= __('idx_stage3_title') %></h2>
          <p class="stage__body"><%= __('idx_stage3_body') %></p>
        </div>
        <figure class="stage__figure">
          <img src="/images/landing/result.webp" width="1400" height="775" loading="lazy" decoding="async" alt="<%= __('idx_stage3_alt') %>" />
          <figcaption class="label"><%= __('idx_stage3_caption') %></figcaption>
        </figure>
      </section>

      <section class="shell stage stage--wide">
        <p class="stage__numeral" aria-hidden="true">4</p>
        <div class="stage__text">
          <p class="stage__no label">4.0</p>
          <h2 class="stage__title"><%= __('idx_stage4_title') %></h2>
          <p class="stage__body"><%= __('idx_stage4_body') %></p>
        </div>
        <figure class="stage__figure">
          <img src="/images/landing/editor.webp" width="1400" height="735" loading="lazy" decoding="async" alt="<%= __('idx_stage4_alt') %>" />
          <figcaption class="label"><%= __('idx_stage4_caption') %></figcaption>
        </figure>
      </section>

      <section class="shell spec" aria-labelledby="spec-title">
        <h2 class="spec__title" id="spec-title"><%= __('idx_spec_title') %><i class="period" aria-hidden="true"></i></h2>
        <dl class="spec__list">
          <div class="spec__cell">
            <dt class="label"><%= __('idx_spec_browser_k') %></dt>
            <dd><%= __('idx_spec_browser_v') %></dd>
          </div>
          <div class="spec__cell">
            <dt class="label"><%= __('idx_spec_input_k') %></dt>
            <dd><%= __('idx_spec_input_v') %></dd>
          </div>
          <div class="spec__cell">
            <dt class="label"><%= __('idx_spec_account_k') %></dt>
            <dd><%= __('idx_spec_account_v') %></dd>
          </div>
          <div class="spec__cell">
            <dt class="label"><%= __('idx_spec_price_k') %></dt>
            <dd><%= __('idx_spec_price_v') %></dd>
          </div>
          <div class="spec__cell">
            <dt class="label"><%= __('idx_spec_source_k') %></dt>
            <dd>
              <a href="https://github.com/HyeokjinKang/URLATE" target="_blank" rel="noopener noreferrer"><%= __('idx_spec_source_front') %></a>
              <a href="https://github.com/HyeokjinKang/URLATE-v3l-backend" target="_blank" rel="noopener noreferrer"><%= __('idx_spec_source_back') %></a>
              <a href="https://mirai.urlate.coupy.dev/docs" target="_blank" rel="noopener noreferrer"><%= __('idx_spec_source_docs') %></a>
            </dd>
          </div>
          <div class="spec__cell">
            <dt class="label"><%= __('idx_spec_license_k') %></dt>
            <dd><%= __('idx_spec_license_v') %></dd>
          </div>
        </dl>
      </section>
    </main>

    <footer class="shell colophon">
      <p>
        URLATE LITE, <%= __('idx_colophon_version') %>
        <% if(branch != "main") { %><b><%= branch %></b><% } else { %><b><%= ver %></b><% } %>.
        <%= __('idx_colophon_body') %>
        <a href="/privacy"><%= __('idx_colophon_privacy') %></a>
        <a href="/info"><%= __('idx_colophon_info') %></a>
        <a href="https://mirai.urlate.coupy.dev/" target="_blank" rel="noopener noreferrer">MIRAI</a>
        <a href="https://discord.gg/YMhYzPbEYV" target="_blank" rel="noopener noreferrer">Discord</a>
        <a href="https://x.com/URLATE_" target="_blank" rel="noopener noreferrer">X</a>
        <% if(__('lang') == 'en') { %>
        <a href="/ko" lang="ko">한국어</a>
        <% } else { %>
        <a href="/en" lang="en">English</a>
        <% } %>
      </p>
    </footer>

    <script nonce="<%= cspNonce %>">
      const projectUrl = "<%= url %>";
      const api = "<%= api %>";
      const loginFailed = "<%= __('login_failed') %>";
      const loginError = "<%= __('login_error') %>";
      const lang = "<%= __('lang') %>";
    </script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="/js/index.js?v=<%= ver %>"></script>
  </body>
</html>
