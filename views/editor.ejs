<!DOCTYPE html>
<html lang="<%= __('lang') %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Editor</title>
    <link rel="preconnect" href="<%= cdn %>" crossorigin />
    <link rel="stylesheet" href="/css/montserrat.css" />
    <link rel="stylesheet" href="/css/pretendard.css" />
    <link rel="stylesheet" href="/css/metropolis.css?v=<%= ver %>" />
    <link rel="stylesheet" href="/css/iziToast.min.css" />
    <link rel="stylesheet" href="/css/globalSocket.css?v=<%= ver %>" />
    <link rel="stylesheet" href="/css/editor.css?v=<%= ver %>" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <script data-pace-options='{ "eventLag": false }' src="/lib/pace.min.js"></script>
  </head>
  <body>
    <div id="initialScreenContainer" class="metropolis">
      <br /><br />
      <h2>Editor</h2>
      <div id="initialButtonsContainer">
        <span id="gotoGame" class="backText clickable" data-action="goGame"
          ><img src="/images/icons/nav-arrow-left.svg" class="backIcon" /><%= __('goto_game') %></span
        >
        <span class="initialButtons clickable" data-action="newEditor"><img src="/images/icons/design-pencil.svg" class="initialIcon clickable" />New</span>
        <span class="initialButtons clickable" data-action="loadEditor"><img src="/images/icons/arrow-down-right-circle.svg" class="initialIcon clickable" />Load</span>
      </div>
      <div id="songSelectionContainer">
        <div id="songSelection">
          <span id="gotoMain" class="backText clickable" data-action="gotoMainConfirm"><img src="/images/icons/nav-arrow-left.svg" class="backIcon" /><%= __('cancel') %></span>
          <h2>Select Song</h2>
          <select id="songSelectBox" class="clickable"></select>
          <input type="button" class="initlalButtons" value="Select" data-action="songSelected" />
        </div>
      </div>
    </div>
    <div id="editorMainContainer">
      <div id="helpContainer" class="metropolis">
        <div id="helpBox">
          <div id="helpTitleContainer">
            <span id="helpTitle">Shortcuts</span>
          </div>
          <div class="helpBoxSpliter">
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>1</kbd></span>
              <span class="helpDescription">Move Tool</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>2</kbd></span>
              <span class="helpDescription">Edit Tool</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>3</kbd></span>
              <span class="helpDescription">Add Tool</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="ctrl">Ctrl</kbd> + <kbd>P</kbd></span>
              <span class="helpDescription">Test Play</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="ctrl">Ctrl</kbd> + <kbd>S</kbd></span>
              <span class="helpDescription">Save</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>T</kbd></span>
              <span class="helpDescription">Toggle Magnet</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>G</kbd></span>
              <span class="helpDescription">Toggle Grid</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>B</kbd></span>
              <span class="helpDescription">Toggle Metronome</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>C</kbd></span>
              <span class="helpDescription">Toggle Circle Grid</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>Esc</kbd></span>
              <span class="helpDescription">Stop</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>Space</kbd> or <kbd>K</kbd></span>
              <span class="helpDescription">Play/Pause</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="noItalic">&lt;</kbd> <kbd class="noItalic">&gt;</kbd></span>
              <span class="helpDescription">Playback Speed</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="noItalic">/</kbd></span>
              <span class="helpDescription">Beat Division</span>
            </div>
          </div>
          <div class="helpBoxSpliter">
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="ctrl">Ctrl</kbd> ( + <kbd class="shift">Shift</kbd> ) + <kbd>C</kbd></span>
              <span class="helpDescription">(Range) Copy</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="ctrl">Ctrl</kbd> ( + <kbd class="shift">Shift</kbd> ) + <kbd>V</kbd></span>
              <span class="helpDescription">(Range) Paste</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="del">Del</kbd></span>
              <span class="helpDescription">Delete</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="alt">Alt</kbd></span>
              <span class="helpDescription">Change Element</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>J</kbd> <kbd>L</kbd></span>
              <span class="helpDescription">Seek by Beat</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="noItalic">←</kbd> <kbd class="noItalic">→</kbd> or <span class="helpMotion">Scroll</span></span>
              <span class="helpDescription">Seek Horizontally</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="noItalic">↑</kbd> <kbd class="noItalic">↓</kbd> or <kbd class="shift">Shift</kbd> + <span class="helpMotion">Scroll</span></span>
              <span class="helpDescription">Seek Vertically</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>R</kbd></span>
              <span class="helpDescription">Origin Reflection</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>H</kbd></span>
              <span class="helpDescription">Horizontal Reflection</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd>V</kbd></span>
              <span class="helpDescription">Vertical Reflection</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="noItalic">−</kbd> <kbd class="noItalic">+</kbd></span>
              <span class="helpDescription">Timeline Zoom</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="ctrl">Ctrl</kbd> + <kbd>Z</kbd></span>
              <span class="helpDescription">Undo</span>
            </div>
            <div class="helpKeyContainer">
              <span class="helpKey"><kbd class="ctrl">Ctrl</kbd> + <kbd class="shift">Shift</kbd> + <kbd>Z</kbd></span>
              <span class="helpDescription">Redo</span>
            </div>
          </div>
        </div>
      </div>
      <div id="navbar">
        <div id="topLeftBar" class="navbarElements">
          <span class="backText clickable" data-action="gotoMain"><img src="/images/icons/nav-arrow-left.svg" class="backIcon" /><%= __('editor_main') %></span>
        </div>
        <div id="topCenterBar" class="navbarElements">
          <span id="songName" class="metropolis">Song Name here</span>
        </div>
        <div id="topRightBar" class="navbarElements">
          <img src="/images/icons/sidebar-expand.svg" id="sidebarBtn" class="icon clickable sidebar-expand" data-action="toggleSettings" />
        </div>
      </div>
      <div id="workingSpaceContainer">
        <div id="workingContainer">
          <div id="menuContainer">
            <img src="/images/icons/resize.svg" class="menuIcon menuSelected" data-action="changeMode" data-arg="0" />
            <img src="/images/icons/edit-pencil-solid.svg" class="menuIcon clickable" data-action="changeMode" data-arg="1" />
            <img src="/images/icons/plus-circle-solid.svg" class="menuIcon clickable" data-action="changeMode" data-arg="2" />
            <div id="horizontalLine" class="menuIcon">&nbsp;</div>
            <img src="/images/icons/play-solid.svg" class="menuIcon clickable" data-action="test" />
            <img src="/images/icons/floppy-disk-solid.svg" class="menuIcon clickable" data-action="save" />
            <div id="horizontalLine" class="menuIcon">&nbsp;</div>
            <img src="/images/icons/magnet-solid.svg" class="menuIcon clickable menuSelected" data-action="toggleMagnet" />
            <img src="/images/icons/orthogonal-view.svg" class="menuIcon clickable menuSelected" data-action="toggleGrid" />
            <div id="metronomeContainer">
              <img src="/images/icons/metronome.svg" id="metronome" class="menuIcon clickable" data-action="toggleMetronome" />
            </div>
            <img src="/images/icons/one-point-circle.svg" class="menuIcon clickable" data-action="toggleCircle" />
          </div>
          <div id="toolContainer">
            <img src="/images/icons/copy.svg" class="toolIcon clickable" data-action="elementCopy" />
            <span class="toolText">Copy</span>
            <img src="/images/icons/paste-clipboard.svg" class="toolIcon clickable" data-action="elementPaste" />
            <span class="toolText">Paste</span>
            <img src="/images/icons/keyframes.svg" class="toolIcon clickable" data-action="rangeCopy" />
            <span class="toolText">Range<br />Copy</span>
            <img src="/images/icons/transition-right.svg" class="toolIcon clickable" data-action="rangePaste" />
            <span class="toolText">Range<br />Paste</span>
            <div id="horizontalLine" class="menuIcon">&nbsp;</div>
            <img src="/images/icons/dot-arrow-right.svg" class="toolIcon clickable" data-action="moveTo" />
            <span class="toolText">Move</span>
            <img src="/images/icons/question-mark.svg" class="toolIcon clickable" data-mouseover="showHelp" data-mouseout="hideHelp" />
            <span class="toolText">Shortcuts</span>
          </div>
          <div id="componentView" data-mousemove="trackMousePos" data-mousedown="compClicked">
            <div id="canvasContainer">
              <div id="canvasBackground"></div>
              <canvas id="componentCanvas" width="100%" height="100%"> </canvas>
            </div>
          </div>
        </div>
        <div id="settingsContainer">
          <div id="settingsName">
            <span id="dot">·</span>
            <span id="settingsNameSpace">Settings</span>
          </div>
          <div id="settingsProperties" class="metropolis">
            <div id="elementsSettings">
              <div id="noteSettingsContainer">
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">POSITION</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">X</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="x" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">Y</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="y" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">DIRECTION</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Direction" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">DURATION</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Duration" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">ACTION</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">CHANGE</span>
                    <input type="button" class="settingsButtons metropolis clickable" data-action="changeNote" value="▶" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">DELETE</span>
                    <input type="button" class="settingsButtons metropolis clickable" data-action="deleteElement" value="▶" />
                  </div>
                </div>
              </div>
              <div id="bulletSettingsContainer">
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">POSITION</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">SIDE</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Side" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">LOCATION</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Location" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">ANGLE</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Angle" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">SPEED</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Speed" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">ACTION</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">DELETE</span>
                    <input type="button" class="settingsButtons metropolis clickable" data-action="deleteElement" value="▶" />
                  </div>
                </div>
              </div>
              <div id="triggerInitializeContainer">
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">GENERAL</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TYPE</span>
                    <select class="settingsSelectBox metropolis clickable" id="triggerInitBox" data-change="triggerSet">
                      <option></option>
                      <option>Destroy</option>
                      <option>Destroy All</option>
                      <option>BPM</option>
                      <option>Opacity</option>
                      <option>Speed</option>
                      <option>Text</option>
                      <option>End</option>
                    </select>
                  </div>
                </div>
              </div>
              <div id="triggerSettingsContainer">
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">GENERAL</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TYPE</span>
                    <select class="settingsSelectBox metropolis clickable" id="triggerSelectBox" data-change="triggerSetTrue">
                      <option>Destroy</option>
                      <option>Destroy All</option>
                      <option>BPM</option>
                      <option>Opacity</option>
                      <option>Speed</option>
                      <option>Text</option>
                      <option>End</option>
                    </select>
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TARGET NUM</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="triggersInput" data-keyup-arg="num" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">BPM</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-blur="triggersInput" data-blur-arg="bpm" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">OPACITY</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="triggersInput" data-keyup-arg="opacity" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">SPEED</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-blur="triggersInput" data-blur-arg="speed" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">V-ALIGN</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-blur="triggersInput" data-blur-arg="valign" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">ALIGN</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-blur="triggersInput" data-blur-arg="align" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">WEIGHT</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="triggersInput" data-keyup-arg="weight" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">SIZE</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="triggersInput" data-keyup-arg="size" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">DURATION</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-blur="triggersInput" data-blur-arg="duration" />
                  </div>
                  <p class="settingsSemiTitle">POSITION</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">X</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="triggersInput" data-keyup-arg="x" />
                  </div>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">Y</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="triggersInput" data-keyup-arg="y" />
                  </div>
                  <p class="settingsSemiTitle">VALUE</p>
                  <div class="settingsPropertiesIndividual column">
                    <span class="settingsPropertiesTitle">TEXT</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis left" data-keyup="triggersInput" data-keyup-arg="text" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">PROPERTY</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">TIMING</span>
                    <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="settingsInput" data-keyup-arg="Timing" />
                  </div>
                </div>
                <div class="settingsPropertiesContainer">
                  <p class="settingsSemiTitle">ACTION</p>
                  <div class="settingsPropertiesIndividual">
                    <span class="settingsPropertiesTitle">DELETE</span>
                    <input type="button" class="settingsButtons metropolis clickable" data-action="deleteElement" value="▶" />
                  </div>
                </div>
              </div>
            </div>
            <div id="trackSettings">
              <div class="settingsPropertiesContainer">
                <p class="settingsSemiTitle">INFORMATION</p>
                <div class="settingsPropertiesIndividual">
                  <span class="settingsPropertiesTitle">TRACK</span>
                  <input type="text" class="settingsPropertiesTextbox metropolis left" readonly />
                </div>
                <div class="settingsPropertiesIndividual">
                  <span class="settingsPropertiesTitle">PRODUCER</span>
                  <input type="text" class="settingsPropertiesTextbox metropolis left" readonly />
                </div>
                <div class="settingsPropertiesIndividual">
                  <span class="settingsPropertiesTitle">AUTHOR</span>
                  <input type="text" class="settingsPropertiesTextbox metropolis left" value="" />
                </div>
                <div class="settingsPropertiesIndividual column">
                  <span class="settingsPropertiesTitle">COMMENT</span>
                  <input type="text" class="settingsPropertiesTextbox metropolis left" value="" />
                </div>
              </div>
              <div class="settingsPropertiesContainer">
                <p class="settingsSemiTitle">PROPERTY</p>
                <div class="settingsPropertiesIndividual">
                  <span class="settingsPropertiesTitle">BPM</span>
                  <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="changeBPM" />
                </div>
                <div class="settingsPropertiesIndividual">
                  <span class="settingsPropertiesTitle">SPEED</span>
                  <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="changeSpeed" value="1" />
                </div>
                <div class="settingsPropertiesIndividual">
                  <span class="settingsPropertiesTitle">SYNC</span>
                  <input type="text" class="settingsPropertiesTextbox metropolis" data-keyup="changeOffset" value="0" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="timelineContainer" data-mousemove="trackTimelineMousePos" data-mousedown="tmlClicked">
        <div id="timelineInner"></div>
      </div>
      <canvas id="timelineCanvas" width="100%" height="100%"> </canvas>
      <div id="timelineZoomController" class="controllers">
        <img src="/images/icons/zoom-in.svg" class="clickable timeline-icon" data-action="zoomIn" />
        <img src="/images/icons/zoom-out.svg" class="clickable timeline-icon" data-action="zoomOut" />
      </div>
      <div id="timelinePlayController" class="controllers">
        <img src="/images/icons/play-solid.svg" id="controlBtn" class="clickable timeline-play" data-action="songPlayPause" />
        <img src="/images/icons/stop-solid.svg" class="clickable timeline-icon" data-action="stopBtn" />
        <span class="clickable" id="percentage" data-action="changeRate">100%</span>
      </div>
      <div id="timelineSplitController" class="controllers">
        <span class="clickable" id="split" data-action="changeSplit">1/2</span>
      </div>
    </div>
    <div class="overlay" id="volumeOverlay">
      <p class="optionSemiTitle"><%= __('volume') %></p>
      <input type="range" min="0" max="100" value="50" id="volumeMaster" class="optionSlider" data-setting="volumeMaster" />
      <p class="optionValue" id="volumeMasterValue">50%</p>
    </div>
    <script nonce="<%= cspNonce %>">
      const moveToAlert = "<%= __('moveToAlert') %>";
      const timeAlert = "<%= __('timeAlert') %>";
      const copiedText = "<%= __('copied') %>";
      const syncAlert = "<%= __('syncAlert') %>";
      const rangeCopyAlert = "<%= __('rangeCopyAlert') %>";
      const cdn = "<%= cdn %>";
      const url = "<%= url %>";
      const api = "<%= api %>";
      const game = "<%= game %>";
      const alias = "<%= __('alias') %>".split(",");
      const lang = "<%= __('lang') %>";
      const socketi18n = {
        connected: "<%= __('socket_status_connected') %>",
        reconnecting: "<%= __('socket_status_reconnecting') %>",
        conflict: "<%= __('socket_connection_conflict') %>",
        error: "<%= __('socket_connection_error') %>",
        unauthorized: "<%= __('socket_connection_unauthorized') %>",
        reward: "<%= __('socket_achievement_reward') %>",
        alias: "<%= __('socket_achievement_alias') %>",
      };
    </script>
    <script src="/lib/socket.io.min.js"></script>
    <script src="/lib/howler.min.js"></script>
    <script src="/lib/iziToast.min.js"></script>
    <script type="module" src="/modules/socket.js?v=<%= ver %>"></script>
    <script type="module" src="/js/editor.js?v=<%= ver %>"></script>
  </body>
</html>
