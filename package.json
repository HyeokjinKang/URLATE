{
  "repository": {
    "type": "git",
    "url": "https://github.com/HyeokjinKang/URLATE"
  },
  "engines": {
    "node": "24",
    "pnpm": "11"
  },
  "name": "urlate",
  "version": "1.0.0-preview.5.3",
  "description": "URLATE, Online rhythm game based on web technologies.",
  "main": "src/",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc",
    "auto-build": "tsc-watch",
    "dev": "supervisor dist/index.js",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop URLATE-v3l-frontend",
    "minify": "for f in public/js/*.js public/modules/*.js; do terser \"$f\" --compress --mangle --output \"$f\"; done",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Coupyworks",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "i18n": "^0.15.3",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "nsfwjs": "^4.4.0",
    "sharp": "^0.35.3",
    "signale": "^1.4.0",
    "tsc-watch": "^7.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ejs": "^1.0.3",
    "supervisor": "^0.12.0",
    "terser": "^5.50.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
